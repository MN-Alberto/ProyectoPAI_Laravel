# Forzamos LF en todos los archivos de texto
* text=auto eol=lf

*.sh text eol=lf
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.blade.php text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
